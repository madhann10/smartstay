# =============================================================================
# SmartStay — Environment Variables Example
# =============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT OR CONFIGURE ON YOUR DEPLOYMENT PROVIDER

# -----------------------------------------------------------------------------
# Database & Secrets (Backend)
# -----------------------------------------------------------------------------
# Production MongoDB Atlas connection string:
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/hotel_booking?retryWrites=true&w=majority

# JWT signing secret (use a long random string in production):
JWT_SECRET=production-jwt-secret-replace-with-long-random-string

# OTP hash secret:
OTP_HASH_SECRET=production-otp-secret-replace-with-long-random-string

# Server Port & CORS Configuration:
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://smartstay-app.vercel.app,https://smartstay.onrender.com
FRONTEND_URL=https://smartstay-app.vercel.app

# -----------------------------------------------------------------------------
# Email / Nodemailer Configuration (Backend)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=SmartStay <noreply@smartstay.com>
DEV_EMAIL_LOGGING=false

# -----------------------------------------------------------------------------
# Google OAuth Configuration (Backend & Frontend)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Frontend API URL Configuration (Vite Build)
# -----------------------------------------------------------------------------
# Set this on Vercel / Netlify / Render frontend environment variables:
VITE_API_URL=https://smartstay-backend.onrender.com
